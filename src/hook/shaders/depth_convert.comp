#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#ifdef DEPTH_MSAA
layout(binding = 0) uniform sampler2DMS uDepthTex;
#else
layout(binding = 0) uniform sampler2D uDepthTex;
#endif
layout(binding = 1, r8) uniform writeonly image2D uOutGray;
layout(binding = 2, rgba8) uniform writeonly image2D uOutRgba;

layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint mode;       // 0 = Gray8, 1 = ColorPhase, 2 = Rgb24Lossless
    uint linearize;
    uint reversed_z;
    float z_near;
    float z_far;
    float pad;
    vec2 source_scale;
    vec2 source_offset;
} pc;

float linearize_depth(float d) {
    d = clamp(d, 0.0, 1.0);
    if (pc.reversed_z != 0u) {
        d = 1.0 - d;
    }
    float denom = pc.z_far - d * (pc.z_far - pc.z_near);
    if (denom <= 1e-6) {
        return 1.0;
    }
    float z_view = (pc.z_near * pc.z_far) / denom;
    return clamp((z_view - pc.z_near) / max(pc.z_far - pc.z_near, 1e-6), 0.0, 1.0);
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (uint(gid.x) >= pc.width || uint(gid.y) >= pc.height) {
        return;
    }

    ivec2 src = ivec2((vec2(gid) + 0.5) * pc.source_scale + pc.source_offset);
#ifdef DEPTH_MSAA
    float d_raw = clamp(texelFetch(uDepthTex, src, 0).r, 0.0, 1.0);
#else
    float d_raw = clamp(texelFetch(uDepthTex, src, 0).r, 0.0, 1.0);
#endif

    if (pc.mode == 0u) {
        float d = (pc.linearize != 0u) ? linearize_depth(d_raw) : d_raw;
        imageStore(uOutGray, gid, vec4(d, 0.0, 0.0, 1.0));
        return;
    }

    if (pc.mode == 1u) {
        float d = (pc.linearize != 0u) ? linearize_depth(d_raw) : d_raw;
        float theta = 6.28318530718 * 8.0 * d;
        float g = 0.5 + 0.5 * cos(theta);
        float b = 0.5 + 0.5 * sin(theta);
        imageStore(uOutRgba, gid, vec4(d, g, b, 1.0));
        return;
    }

    // Mode 2: Exact 24-bit integer packing across RGB bytes
    uint u24 = uint(clamp(round(d_raw * 16777215.0), 0.0, 16777215.0));
    float r = float((u24 >> 16u) & 0xFFu) / 255.0;
    float g = float((u24 >> 8u) & 0xFFu) / 255.0;
    float b = float(u24 & 0xFFu) / 255.0;
    imageStore(uOutRgba, gid, vec4(r, g, b, 1.0));
}
